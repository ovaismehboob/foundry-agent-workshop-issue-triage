# Copy this file to app/.env and fill in your own values. Never commit app/.env.
# Values come from the Microsoft Foundry portal (see the student guide). They are identifiers, not secrets.

# Module 3 - Project endpoint from the project Overview / Home page.
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=<your-project-endpoint>

# Module 3 - Name of your chat model deployment (for example gpt-5-mini).
MICROSOFT_FOUNDRY_MODEL_DEPLOYMENT_NAME=<your-model-deployment-name>

# Module 3, Exercise 3.1 - The Prompt Agent you created in the portal in Module 1.
PROMPT_AGENT_NAME=issue-triage-agent
PROMPT_AGENT_VERSION=<your-prompt-agent-version>

# Module 5 - Foundry IQ knowledge base (created in Module 4).
# Search endpoint format: https://<search-service-name>.search.windows.net
AZURE_SEARCH_ENDPOINT=<your-search-endpoint>
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=<your-knowledge-base-name>

# Optional settings
LOG_LEVEL=WARNING
TRIAGE_REQUEST_TIMEOUT_SECONDS=90
TRIAGE_MAX_ISSUE_CHARS=4000
# Seconds to wait for `az`/`azd` when getting a sign-in token (raise it if the Azure CLI starts slowly).
LAB_CREDENTIAL_PROCESS_TIMEOUT=30
